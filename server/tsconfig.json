{
    "compilerOptions": {
      "target": "es2015", 
      "lib": ["esnext"], 
      "module": "commonjs", 
      "moduleResolution": "node",
      "outDir": "./dist", 
      "rootDir": "./src",
      "allowJs": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "forceConsistentCasingInFileNames": true,
      "noFallthroughCasesInSwitch": true,
      "resolveJsonModule": true
    },
    "include": ["src"]
  }
  